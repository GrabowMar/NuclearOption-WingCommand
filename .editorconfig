root = true

[*.cs]

# Flag unused private members at build time. Document local IDE0051 suppressions
# for Unity lifecycle methods and Harmony patches invoked through reflection.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# The NOAvionics toolkit is synced from Boscali Summer (tools/sync-avionics.ps1) and never edited here; Unity calls its
# private lifecycle messages (Awake) by name.
[{Avionics,AvionicsUi}/**.cs]
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0052.severity = none
