/* ===========================================================================
   avionics.avss — the look of every Wing Command and Boscali Summer panel.

   This file is compiled into both plugins as the default. To retune the panels
   without rebuilding, drop a copy at:

       BepInEx/config/NOAvionics/avionics.avss

   ...edit it, and reload in game. A syntax error is logged with its line number
   and the last good sheet is kept, so a bad edit never leaves you with no UI.

   Grammar: class selectors only, one optional state, flat properties.
     .a          matches an element carrying class "a"
     .a.b        matches an element carrying BOTH classes
     .a:hover    a state; states always win over stateless rules
   Colours are #RRGGBB with an optional two-hex-digit alpha after a space.
   "accent" / "friendly" / "warning" / "alert" follow the player's live theme.
   =========================================================================== */

:root {
  /* Neutral surfaces; only operational state wears the live game palette. */
  ground:             #06090A fb;
  surface-sunken:     #080B0D f8;
  surface:            #0C1113 fa;
  surface-raised:     #131A1C fa;
  surface-inert:      #080B0D f0;
  band:               #FFFFFF 04;
  surface-track:      #FFFFFF 14;

  /* --- Structural Edges & Bezel Framing --- */
  border-subtle:      #2E3B40 80;
  hairline:           #2E3B40 a6;
  frame:              #475C63 d9;
  border-active:      accent;

  /* State follows the player's vanilla theme. Info remains a quiet blue-grey. */
  rail-ready:         accent;
  rail-caution:       warning;
  rail-danger:        alert;
  rail-info:          #80C2D9;
  rail-inert:         #40545C a6;

  /* --- Calibrated Phosphor Bloom & Washes --- */
  rail-ready-glow:    accent 14;
  rail-ready-edge:    accent 80;
  rail-caution-glow:  warning 14;
  rail-caution-edge:  warning 80;
  rail-danger-glow:   alert 14;
  rail-danger-edge:   alert 80;
  rail-info-glow:     #80C2D9 14;
  rail-info-edge:     #80C2D9 80;

  /* --- Photopic Typography & Ink --- */
  text-primary:       #EBF2F5;
  text-dim:           #ADBFC7;
  text-muted:         #788F99;
  ink:                #010C06;

  /* --- Panel Geometry --- */
  panel-width:        480;
  pad:                14;
  gap:                8;
}

/* ---------------------------------------------------------------- 1. panel */

/* Fill fades from ground-dark to see-through over the panel's own bottom
   stretch (baked into the "panel" sprite, not tunable from here). */
.panel        { sprite: panel; border: 1 frame; ticks: off; }

/* The spine: refined into an elegant structural rail rather than a glaring laser bar,
   with crisp accent ticks at section heads. */
.spine        { width: 1; background: hairline; }
.spine-tick   { width: 5; height: 1; background: frame; }

/* ------------------------------------------------------------ 2. sections */

.section      { pad: 10 12; gap: 8; }
.section.band { background: band; }

/* Section headers sit one step above body copy: 11px bold, no more tracking than the
   data under them so they read as headings instead of faint decoration. */
.section-title      { font: 11 bold; color: text-primary; tracking: 1; }
.section-title-note  { font: 11; color: text-dim; tracking: 0; }

/* ------------------------------------------------------- 2b. page heading */

/* The panel's own headline: large enough to name the page at a glance, with a
   tracked subtitle under it. Sits above the scroll area and never moves. */
.page-title    { font: 18 bold; color: text-primary; tracking: 1; }
.page-subtitle { font: 11; color: text-dim; tracking: 0; }

/* ------------------------------------------------------------ 4. data bar */

.databar           { height: 54; }
.id-tag            { color: text-primary; font: 14 bold; tracking: 2; align: center; }
.databar-state     { font: 13; color: text-dim; tracking: 1; }
.databar-state-key { font: 13 bold; color: text-primary; tracking: 1; }

.chip        { font: 11; color: text-dim; tracking: 0; background: surface-raised; }
.chip.live   { color: text-primary; }
.chip.warn   { color: warning; }
.chip.danger { color: alert; }
.chip.info   { color: rail-info; }
.chip.inert  { color: text-muted; background: surface-inert; }

/* -------------------------------------------------------------- 5. metrics */

.metrics       { height: 64; background: surface; }
.metric        { pad: 4 10; background: surface; }
.metric-key    { font: 10.5; color: text-dim; tracking: 0; }
.metric-value  { font: 21 bold; color: text-primary; tabular: on; tracking: 0; }
.metric-unit   { font: 10.5; color: text-dim; tracking: 0; }
.metric-cap    { font: 10.5; color: text-dim; tracking: 0; align: right; }
.metric-track  { height: 2; background: surface-track; }

/* One hero reading per page — a tuned frequency, a countdown. Sized between the
   metric value and a display face, tabular so it does not jitter as it changes. */
.readout       { font: 26 bold; color: text-primary; tabular: on; tracking: 0; }
.readout-unit  { font: 11; color: text-dim; tracking: 0; }

/* ----------------------------------------------------------------- 6. tabs */

.tabbar      { height: 30; border: 1 hairline; background: surface-sunken; }
.tab         { font: 11 bold; color: text-dim; tracking: 1; background: surface-sunken; border: 1 hairline; align: center; }
.tab:hover   { color: text-primary; background: #0E1E2C c0; border: 1 accent 80; }
.tab:latched { color: text-primary; background: accent 28; border: 1 accent; rail: 2 accent; }

/* ------------------------------------------------------------ 7. list rows */

/* Rows size to their own copy. This is what ends the ellipsis: a description
   that needs two lines gets two lines instead of being cut. */
.row          { pad: 8 12; gap: 8; background: surface; }
.row:hover    { background: surface-raised; border: 1 hairline; }
.row:armed    { background: rail-ready-glow; border: 1 rail-ready-edge; }
.row:disabled { color: text-muted; border: 1 border-subtle 40; background: surface-inert; }

.row-name       { font: 12 bold; color: text-primary; tracking: 0; }
.row-sub        { font: 11; color: text-dim; tracking: 0; wrap: on; }
.row-main       { font: 12; color: text-primary; tracking: 0; wrap: on; }
.row-sub.ok     { color: rail-ready; }
.row-sub.warn   { color: rail-caution; }
.row-sub.bad    { color: rail-danger; }
.row-main.warn  { color: rail-caution; }

.row-value      { font: 13 bold; color: text-primary; tabular: on; align: right; }
.row-value.ok   { color: rail-ready; }
.row-value.warn { color: rail-caution; }
.row-value.bad  { color: rail-danger; }
.row-value-unit { font: 11; color: text-dim; tracking: 0; align: right; }

/* Explanatory copy under a heading: dim, wrapped, never ellipsised. */
.hint           { font: 11.5; color: text-dim; tracking: 0; wrap: on; }

/* State lives on the rail; what a thing *is* lives on its glyph. Colour is
   therefore never the only carrier of meaning. */
.rail           { width: 3; }
.rail.ready     { background: rail-ready; }
.rail.armed     { background: rail-caution; }
.rail.cooling   { background: rail-caution; }
.rail.danger    { background: rail-danger; }
.rail.locked    { background: rail-inert; }
.rail.info      { background: rail-info; }
/* A sector or node under opposing pressure. Separate from :armed so a frontline
   reading amber never means "you have armed something". */
.rail.contested { background: rail-caution; }
.rail.hostile   { background: rail-danger; }

/* ------------------------------------------------------- 7b. readout bars */

/* A share bar: one track, several fills laid end to end. Used for the theater
   control split, where a single-fill progress bar cannot show that the ground
   between two sides is neither side's. */
.bar           { height: 6; background: surface-track; }
.bar-friendly  { background: accent; }
.bar-contested { background: rail-caution; }
.bar-hostile   { background: rail-danger; }
.bar-inert     { background: rail-inert; }

/* Key/value pairs for the logistics readouts: label left, figure right, on one line. */
.kv-key        { font: 11; color: text-dim; tracking: 0; }
.kv-value      { font: 12 bold; color: text-primary; align: right; }
.kv-value.ok   { color: rail-ready; }
.kv-value.warn { color: rail-caution; }
.kv-value.bad  { color: rail-danger; }

/* ------------------------------------------------------------- 8. controls */

.btn, .button, .toggle { font: 11 bold; color: text-primary; tracking: 0; border: 1 frame;
                         background: surface-raised; sprite: control; align: center; }
.btn:hover             { color: text-primary; border: 1 accent; background: #132435 f0; }
.btn:latched           { color: text-primary; background: accent 40; border: 1 accent; }
.btn:disabled          { color: text-muted; border: 1 hairline 40; background: surface-inert; }
.btn.confirm           { color: ink; background: rail-ready; border: 1 #FFFFFF 99; font: 11 bold; }
.btn.confirm:hover     { color: #000000; background: #33FFB8; border: 1 #FFFFFF; }

.badge                 { font: 11; color: text-dim; tracking: 0; border: 1 hairline; pad: 2 6; align: center; }
.badge.on              { color: rail-ready; border: 1 rail-ready-edge; background: rail-ready-glow; }
.badge.aff             { color: rail-caution; border: 1 rail-caution-edge; background: rail-caution-glow; }

/* -------------------------------------------------------- 9. status strip */

.status       { height: 56; background: surface; pad: 8 12; }
.status-text  { font: 12; color: text-dim; wrap: on; tracking: 0; }
.status.armed { border: 1 rail-caution-edge; background: #140E04 f0; }
.status.alert { border: 1 rail-danger-edge; background: #140505 f0; }

/* ------------------------------------------------------------- 10. cards */

/* Kept for the surfaces that genuinely are objects — a pilot dossier, a
   now-playing card. Ordinary groups use .section instead. */
.card         { background: surface-raised; border: 1 hairline; pad: 12; gap: 8; }
.card:hover   { background: #0C1A28 f8; border: 1 frame; }
.card.inert   { background: surface-inert; border: 1 hairline 40; }
.card.focused { border: 1 accent; background: surface-raised; }

/* ------------------------------------------------------------ 11. dossier */

/* A paper personnel file rendered on glass: form numbers, clause rules with
   dotted leaders and rubber stamps. Wing Command never asks for these; the SQD
   pages and the STR chain-of-command dossier both do. */

.file-form     { font: 11; color: text-dim; tracking: 0; }
.file-title    { font: 16 bold; color: text-primary; tracking: 0; }
.file-meta     { font: 11; color: text-dim; tracking: 0; }
.leader        { font: 11; color: text-dim; tracking: 0; }
.form-key      { font: 11; color: text-dim; tracking: 0; }
.form-value    { font: 12 bold; color: text-primary; align: right; }
.photo-cap     { font: 11; color: text-dim; tracking: 0; }

/* A stamp is ink on the file, not a control: inert until a state says otherwise. */
.stamp         { font: 10.5 bold; color: text-muted; tracking: 8; border: 1 #57706A 99; }
.stamp.ok      { color: rail-ready; border: 1 rail-ready-edge; background: rail-ready-glow; }
.stamp.warn    { color: rail-caution; border: 1 rail-caution-edge; background: rail-caution-glow; }
.stamp.bad     { color: rail-danger; border: 1 rail-danger-edge; background: rail-danger-glow; }
.stamp.info    { color: rail-info; border: 1 rail-info-edge; background: rail-info-glow; }

/* A punched filing hole in the binding margin. */
.punch         { background: #000000 f0; border: 1 frame 99; }

/* What the file will not show: redaction bars, and a watermark behind the record. */
.redact        { background: #57706A 59; }
.watermark     { font: 24 bold; color: accent 14; tracking: 12; }

/* ------------------------------------------------ 12. reskinned stock panels */

/* The game's own map panels — BDF, PALA, TGT, MIS, MAP — docked into the left
   column. Their contents and titles stay the game's; this only supplies the
   same top-to-bottom fade as .panel (via AvSprites.GroundGradient, also not
   tunable from here) plus a hairline edge, so the rows read as an instrument
   instead of as green text floating over the terrain. */
.stock-panel   { background: surface-sunken; border: 1 hairline; }
