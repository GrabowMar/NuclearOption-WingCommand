{
  // Wing Command formations. right/aft are in spacing units, up in stack units (10 m); the leader is at
  // the origin. elements list aircraft numbers (0 = leader). User files use the same schema and replace
  // built-ins with the same id.
  "formations": [
    { "id": "echelon-right", "family": "classic", "name": "Echelon Right",
      "spacing": { "min": 40, "max": 160, "default": 80 }, "modifiers": ["turnCompress", "terrainFlatten"],
      "slots": [ { "right": 1, "aft": 1, "up": 0 }, { "right": 2, "aft": 2, "up": 0 }, { "right": 3, "aft": 3, "up": 0 } ],
      "elements": [[0, 1], [2, 3]] },
    { "id": "echelon-left", "family": "classic", "name": "Echelon Left",
      "spacing": { "min": 40, "max": 160, "default": 80 }, "modifiers": ["turnCompress", "terrainFlatten"],
      "slots": [ { "right": -1, "aft": 1, "up": 0 }, { "right": -2, "aft": 2, "up": 0 }, { "right": -3, "aft": 3, "up": 0 } ],
      "elements": [[0, 1], [2, 3]] },
    { "id": "line-abreast", "family": "classic", "name": "Line Abreast",
      "spacing": { "min": 40, "max": 160, "default": 80 }, "modifiers": ["turnCompress", "terrainFlatten"],
      "slots": [ { "right": -1, "aft": 0, "up": 0 }, { "right": 1, "aft": 0, "up": 0 }, { "right": 2, "aft": 0, "up": 0 } ],
