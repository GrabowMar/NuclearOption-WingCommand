<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WingCommand</AssemblyName>
    <RootNamespace>WingCommand</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Milestone prerelease tag; keep in step with Plugin.PluginPrerelease. -->
    <VersionPrerelease>alpha.0</VersionPrerelease>
    <InformationalVersion>$(Version)-$(VersionPrerelease)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <!-- Suppress reference-assembly warnings from Unity runtime assemblies. -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <ManagedDir>$(GameDir)\NuclearOption_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <Target Name="CheckLocalDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="Nuclear Option assemblies not found. Set GameDir to your game installation." />
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.dll')"
           Text="BepInEx 5 not found under $(BepInExDir). Install it in the game directory." />
  </Target>

  <!-- Keep the BepInPlugin compile-time version constant aligned with assembly metadata. -->
  <Target Name="CheckPluginVersionMatchesCsproj" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Core/Plugin.cs'))</_PluginSource>
      <_DeclaredVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PluginSource), 'PluginVersion\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredVersion>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredVersion)' == ''"
           Text="Could not find Plugin.PluginVersion in Core/Plugin.cs. If it moved, update this check." />
    <Error Condition="'$(_DeclaredVersion)' != '$(Version)'"
           Text="Version mismatch: csproj &lt;Version&gt; is '$(Version)' but Plugin.PluginVersion is '$(_DeclaredVersion)'. Bump both." />
    <PropertyGroup>
      <_DeclaredPrerelease>$([System.Text.RegularExpressions.Regex]::Match($(_PluginSource), 'PluginPrerelease\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredPrerelease>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredPrerelease)' != '$(VersionPrerelease)'"
           Text="Prerelease mismatch: csproj &lt;VersionPrerelease&gt; is '$(VersionPrerelease)' but Plugin.PluginPrerelease is '$(_DeclaredPrerelease)'. Bump both." />
  </Target>

  <!-- Files not yet ported to the 1.0 architecture. Each names the milestone that restores it.
       Release builds of a non-prerelease version must have an empty quarantine. -->
  <ItemGroup Label="Quarantine">
    <Quarantine Include="Economy\WingLoadoutBook.cs" Milestone="M3" />
    <Quarantine Include="Combat\CombatFacade.cs" Milestone="M5" />
    <Quarantine Include="Combat\SplashSalvo.cs" Milestone="M5" />
    <Quarantine Include="Economy\HangarDepartureLane.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingHangarStock.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingLoadout.cs" Milestone="M3" />
    <Quarantine Include="Combat\AiCombatTweak.cs" Milestone="M5" />
    <Quarantine Include="Combat\DoctrineLive.cs" Milestone="M5" />
    <Quarantine Include="Combat\TacticalCoordinator.cs" Milestone="M5" />
    <Quarantine Include="Combat\WingWeapons.cs" Milestone="M5" />
    <Quarantine Include="Comms\WingChatterHud.cs" Milestone="M4" />
    <Quarantine Include="Comms\WingRadioAudio.cs" Milestone="M4" />
    <Quarantine Include="Economy\WingAirfield.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingLaunchFields.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingLoadoutTemplates.cs" Milestone="M3" />
    <Quarantine Include="Interop\WingSquad.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingCustomPilots.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingKillCredit.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingPilotLoss.cs" Milestone="M3" />
    <Quarantine Include="Ui\CombatHUDHitAudioPatch.cs" Milestone="M7" />
    <Quarantine Include="Ui\WingMarkerBadge.cs" Milestone="M4" />
    <Quarantine Include="Economy\HangarDeliveryCompletionPatch.cs" Milestone="M3" />
    <Quarantine Include="Economy\EconomyFacade.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingShopDelivery.cs" Milestone="M3" />
    <Quarantine Include="Economy\WingShop.cs" Milestone="M3" />
    <Quarantine Include="Personnel\PilotPortrait.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingSurvivalPerks.cs" Milestone="M3" />
    <Quarantine Include="Ui\WmcScreen.CustomPilots.cs" Milestone="M3" />
    <Quarantine Include="Ui\WmcScreen.Loadout.cs" Milestone="M3" />
    <Quarantine Include="Ui\WmcScreen.Shell.cs" Milestone="M7" />
    <Quarantine Include="Ui\WmcScreen.Supply.cs" Milestone="M3" />
    <Quarantine Include="Ui\WmcScreen.TacticalPreview.cs" Milestone="M4" />
    <Quarantine Include="Combat\SlotEngagement.cs" Milestone="M5" />
    <Quarantine Include="Comms\WingComms.cs" Milestone="M4" />
    <Quarantine Include="Core\WingCommandSelection.cs" Milestone="M4" />
    <Quarantine Include="Personnel\PersonnelFacade.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingDeparture.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingDepartureChatter.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingPilots.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingRecovery.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingRecruitment.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingSearchAndRescue.cs" Milestone="M3" />
    <Quarantine Include="Personnel\WingTakeover.cs" Milestone="M3" />
    <Quarantine Include="Ui\MapCommandLayer.cs" Milestone="M4" />
    <Quarantine Include="Ui\TacticalMapOverlay.cs" Milestone="M4" />
    <Quarantine Include="Ui\WingDebugActions.cs" Milestone="M7" />
    <Quarantine Include="Ui\WingHud.cs" Milestone="M7" />
    <Quarantine Include="Ui\WingHudTint.cs" Milestone="M7" />
    <Quarantine Include="Ui\WingMapTint.cs" Milestone="M4" />
    <Quarantine Include="Ui\WingMarkers.cs" Milestone="M4" />
    <Quarantine Include="Ui\WingRadialOverlay.cs" Milestone="M7" />
    <Quarantine Include="Ui\WmcScreen.Groups.cs" Milestone="M4" />
    <Quarantine Include="Ui\WmcScreen.RouteNodes.cs" Milestone="M4" />
    <Quarantine Include="Ui\WmcScreen.Tactical.cs" Milestone="M4" />
    <Quarantine Include="Ui\WmcScreen.TacticalBento.cs" Milestone="M4" />
    <Quarantine Include="Ui\WmcScreen.TacticalNavigation.cs" Milestone="M4" />
    <Quarantine Include="Ui\WmcScreen.Wing.cs" Milestone="M7" />
    <Quarantine Include="Ui\WmcScreen.cs" Milestone="M7" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="@(Quarantine)" />
  </ItemGroup>
  <Target Name="CheckQuarantine" BeforeTargets="CoreCompile">
    <Error Condition="'$(Configuration)' == 'Release' And '$(VersionPrerelease)' == '' And '@(Quarantine)' != ''"
           Text="Quarantine is not empty; a final release cannot ship with unported files: @(Quarantine)" />
    <Message Importance="high" Condition="'@(Quarantine)' != ''" Text="Quarantined (not compiled): @(Quarantine->Count()) file(s)" />
  </Target>

  <ItemGroup Label="BepInEx / Harmony">
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Label="Game">
    <!-- Access private radial members through GameAccess reflection because application control blocks the publicizer build task. -->
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirage"><HintPath>$(ManagedDir)\Mirage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(ManagedDir)\UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(ManagedDir)\Rewired_Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Label="Test project lives under tests/ and is built standalone; EnableDefaultCompileItems
                     would otherwise double-compile its sources into this plugin too.">
    <Compile Remove="tests\**\*.cs" />
    <!-- Exclude generated assembly metadata from isolated test runs under build/. -->
    <Compile Remove="build\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png" LogicalName="WingCommand.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Pilots\layers.png" LogicalName="WingCommand.PilotLayers.png" />
    <EmbeddedResource Include="Assets\maneuvers.json" LogicalName="WingCommand.maneuvers.json" />
    <EmbeddedResource Include="Assets\Data\formations.json" LogicalName="WingCommand.formations.json" />
    <EmbeddedResource Include="Assets\Data\airframes.json" LogicalName="WingCommand.airframes.json" />

    <!-- Vendored engine-free avionics widget kit + design tokens (namespace NOAvionics / NOAvionics.Ui),
         picked up by the default compile glob from Avionics/ and AvionicsUi/. Boscali Summer carries its
         own byte-identical copy; the two mods share no runtime contract, only this visual language and
         the NOAvionics.avionics.avss resource name. See Avionics/README.md. Live override:
         BepInEx/config/NOAvionics/avionics.avss. -->
    <EmbeddedResource Include="AvionicsUi\avionics.avss">
      <LogicalName>NOAvionics.avionics.avss</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Label="Unity">
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Provide AudioClip for the click preceding squadron transmissions. -->
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
