<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>WingCommand.PureTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Assets\maneuvers.json" Link="maneuvers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\formations.json" Link="formations.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Label="Pure/ is engine-free by convention; link its sources directly rather
                     than referencing WingCommand.csproj, which requires the game's
                     Unity/BepInEx assemblies to be present on disk to build.">
    <Compile Include="..\..\Pure\**\*.cs" Link="Pure\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Avionics\*.cs" Link="Avionics\%(Filename)%(Extension)" />
    <Compile Include="..\..\Agents\HoverAssist.cs" Link="Agents\HoverAssist.cs" />
  </ItemGroup>

  <!-- Tests whose production subject is quarantined in WingCommand.csproj; restored with it. -->
  <ItemGroup Label="Quarantine">
    <Compile Remove="WingKillCreditTests.cs" /> <!-- M3 -->
    <Compile Remove="HangarDepartureLaneTests.cs" /> <!-- M3 -->
    <Compile Remove="Ui\MapInputTests.cs" /> <!-- M4 -->
    <Compile Remove="Ui\WingMapPresentationTests.cs" /> <!-- M4 -->
  </ItemGroup>

</Project>
