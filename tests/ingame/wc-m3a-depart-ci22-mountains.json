    {
      "check": "result_below",
      "path": "ground.grounded",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "ground.relocated",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "wing.left",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "ground.aborted",
      "max": 0
    }
  ]
