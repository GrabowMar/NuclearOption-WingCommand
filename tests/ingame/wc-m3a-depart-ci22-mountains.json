        "count": 3,
        "type": "CI-22 Cricket"
      }
    },
    {
      "op": "record",
      "ids": [
        "lead"
      ],
      "hz": 2
    },
    {
      "op": "wait",
      "seconds": 60
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Ground",
      "store": "early"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.DumpFields"
    },
    {
      "op": "wait",
      "seconds": 300
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Members"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Ground",
      "store": "ground"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Metrics",
      "store": "wing"
