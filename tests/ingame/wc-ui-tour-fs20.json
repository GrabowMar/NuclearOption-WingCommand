   "path": "form.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "plan.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "supply.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "loadout.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "squadron.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "empty.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "plan_elements.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "plan_route.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "plan_log.overflow",
   "max": 0
  },
  {
   "check": "result_below",
   "path": "inspect.overflow",
   "max": 0
  },
  {
   "check": "result_above",
   "path": "inspect.inspect_member",
   "min": 2
  },
  {
   "check": "result_below",
   "path": "timeline.overflow",
   "max": 0
  },
  {
   "check": "result_above",
   "path": "debrief.pressed",
   "min": 1
