{
  "name": "wc-r3-orders-fs20",
  "mods": ["wingcommand"],
  "timeout_s": 360,
  "ops": [
    {"op": "spawn", "id": "lead", "type": "FS-20 Vortex", "at": {"map": [0, 0]}, "altitude": 3000, "speed": 200, "heading": 0},
    {"op": "fly", "id": "lead", "program": [{"level": 280}]},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "WingCommand.Automation.FormOn", "store": "form",
     "args": {"lead": "lead", "count": 3, "shape": "finger-four-right", "spacing": "Standard"}},
    {"op": "call", "method": "WingCommand.Automation.Doctrine", "store": "doctrine", "args": {"name": "Sweep"}},
    {"op": "wait", "seconds": 60},

    {"op": "call", "method": "WingCommand.Automation.Order", "store": "silent", "args": {"kind": "SetOverride", "number": 7, "text": "Silent"}},
    {"op": "call", "method": "WingCommand.Automation.Order", "store": "guns", "args": {"kind": "SetOverride", "number": 6, "text": "Guns"}},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "WingCommand.Automation.CombatState", "store": "quiet"},
    {"op": "call", "method": "WingCommand.Automation.Order", "store": "maneuver", "args": {"kind": "Maneuver", "number": 1}},
    {"op": "wait", "seconds": 30},
    {"op": "call", "method": "WingCommand.Automation.CombatState", "store": "after_maneuver"},

    {"op": "spawn", "id": "b1", "type": "FS-12 Revoker", "faction": "Primeva", "at": {"map": [-1000, 30000]}, "altitude": 3000, "speed": 220, "heading": 180},
    {"op": "spawn", "id": "b2", "type": "FS-12 Revoker", "faction": "Primeva", "at": {"map": [1000, 30000]}, "altitude": 3000, "speed": 220, "heading": 180},
    {"op": "wait", "seconds": 60},
    {"op": "call", "method": "WingCommand.Automation.CombatState", "store": "standing"},

    {"op": "call", "method": "WingCommand.Automation.Engage", "store": "engage"},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "WingCommand.Automation.CombatState", "store": "fighting"},
    {"op": "call", "method": "WingCommand.Automation.Disengage", "store": "disengage"},
    {"op": "wait", "seconds": 20},

    {"op": "call", "method": "WingCommand.Automation.Ground", "store": "guard_before"},
    {"op": "call", "method": "WingCommand.Automation.Order", "store": "eject", "args": {"kind": "Eject", "members": [4], "flag": true}},
    {"op": "call", "method": "WingCommand.Automation.Order", "store": "eject_unconfirmed", "args": {"kind": "Eject", "members": [3]}},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "WingCommand.Automation.Members", "store": "after_eject"},
    {"op": "call", "method": "WingCommand.Automation.Ground", "store": "guard_after"},

    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "panel", "args": {"open": true, "tab": 0, "sub": 0}},
    {"op": "call", "method": "WingCommand.Automation.Damage", "store": "hurt", "args": {"member": 2, "hp": 40}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "alerts_damaged"},
    {"op": "call", "method": "WingCommand.Automation.Damage", "store": "kill", "args": {"member": 3, "kill": true}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "alerts_lost"},
    {"op": "call", "method": "WingCommand.Automation.Members", "store": "after_loss"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "form.spawned", "min": 3},
    {"check": "result_above", "path": "silent.accepted", "min": 1},
    {"check": "result_above", "path": "guns.accepted", "min": 1},
    {"check": "result_below", "path": "quiet.radars_on", "max": 0},
    {"check": "result_above", "path": "maneuver.accepted", "min": 1},
    {"check": "result_above", "path": "after_maneuver.reacts", "min": 3},
    {"check": "result_below", "path": "standing.standing_shots", "max": 0},
    {"check": "result_below", "path": "standing.radars_on", "max": 0},
    {"check": "result_above", "path": "fighting.radars_on", "min": 1},
    {"check": "result_above", "path": "eject.accepted", "min": 1},
    {"check": "result_below", "path": "eject_unconfirmed.accepted", "max": 0},
    {"check": "result_below", "path": "after_eject.count", "max": 2},
    {"check": "result_below", "path": "guard_after.ejections_blocked", "max": 0},
    {"check": "result_above", "path": "alerts_damaged.alerts", "min": 1},
    {"check": "result_above", "path": "alerts_lost.alerts", "min": 2},
    {"check": "result_below", "path": "after_loss.count", "max": 1}
  ]
}
