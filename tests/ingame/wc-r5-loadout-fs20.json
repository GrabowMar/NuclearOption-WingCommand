{
  "name": "wc-r5-loadout-fs20",
  "mods": [
    "wingcommand"
  ],
  "timeout_s": 420,
  "ops": [
    {"op": "spawn", "id": "lead", "type": "FS-20 Vortex", "at": {"map": [-18632, 32049]}, "altitude": 900, "speed": 150, "heading": 0},
    {"op": "fly", "id": "lead", "program": [{"orbit": {"bank": 15, "seconds": 400}}]},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "WingCommand.Automation.Anchor", "store": "anchor", "args": {"id": "lead"}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "WingCommand.Automation.Grant", "store": "grant",
     "args": {"lead": "lead", "allocation": 100000000, "type": "FS-20 Vortex", "stock": 4, "rank": 10}},
    {"op": "call", "method": "WingCommand.Automation.Pilots", "store": "hired", "args": {"hire": 2}},
    {"op": "record", "ids": ["lead"], "hz": 2},

    {"op": "call", "method": "WingCommand.Automation.LoadoutProfile", "store": "profile", "args": {"airframe": "FS-20 Vortex"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "page",
     "args": {"open": true, "tab": "LOADOUT", "lo_airframe": "FS-20 Vortex", "lo_reset": true}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "made", "args": {"press": "lo.new"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "named", "args": {"lo_name": "cap two"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "armed", "args": {"lo_station": 0, "lo_store": "#1"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "popup", "args": {"press": "lo.hp0"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "cleared", "args": {"press": "lo.hp0.clear"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "rearmed", "args": {"lo_station": 0, "lo_store": "#1"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "copied", "args": {"press": "lo.copy"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "ask", "args": {"press": "lo.delete"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "deleted", "args": {"press": "lo.delete"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "chosen", "args": {"lo_template": "CAP TWO"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "livery", "args": {"lo_livery": "next"}},

    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "focused", "args": {"lo_focus": true}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "switched", "args": {"press": "tab.supply"}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "back", "args": {"tab": "LOADOUT"}},

    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "supply",
     "args": {"tab": "SUPPLY", "airframe": "FS-20 Vortex", "fit": "CAP TWO", "base": "airbase_boscali_north"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "req", "args": {"press": "sup.requisition"}},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "WingCommand.Automation.Members", "store": "members", "args": {"template": "CAP TWO"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "full", "args": {"tab": "LOADOUT"}},
    {"op": "call", "method": "WingCommand.Automation.Wmc", "store": "cleanup", "args": {"lo_airframe": "FS-20 Vortex", "lo_reset": true}},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "profile.sets", "min": 1},
    {"check": "result_above", "path": "page.tab", "min": 5},
    {"check": "result_below", "path": "page.tab", "max": 5},
    {"check": "result_below", "path": "page.overflow", "max": 0},
    {"check": "result_above", "path": "page.lo_tiles", "min": 1},
    {"check": "result_above", "path": "page.lo_rows", "min": 1},
    {"check": "result_below", "path": "page.lo_templates", "max": 0},
    {"check": "result_above", "path": "made.lo_templates", "min": 1},
    {"check": "result_above", "path": "made.lo_editing", "min": 1},
    {"check": "result_below", "path": "made.lo_fitted", "max": 0},
    {"check": "result_below", "path": "made.overflow", "max": 0},
    {"check": "result_above", "path": "armed.lo_fitted", "min": 1},
    {"check": "result_above", "path": "armed.lo_mass", "min": 1},
    {"check": "result_above", "path": "popup.lo_popup_clear", "min": 1},
    {"check": "result_below", "path": "popup.overflow", "max": 0},
    {"check": "result_below", "path": "cleared.lo_fitted", "max": 0},
    {"check": "result_above", "path": "rearmed.lo_fitted", "min": 1},
    {"check": "result_above", "path": "copied.lo_templates", "min": 2},
    {"check": "result_above", "path": "ask.lo_delete_armed", "min": 1},
    {"check": "result_below", "path": "deleted.lo_templates", "max": 1},
    {"check": "result_above", "path": "chosen.lo_fitted", "min": 1},
    {"check": "result_above", "path": "livery.lo_liveries", "min": 1},
    {"check": "result_above", "path": "focused.lo_name_focused", "min": 1},
    {"check": "result_above", "path": "focused.lo_keyboard_held", "min": 1},
    {"check": "result_below", "path": "back.lo_name_focused", "max": 0},
    {"check": "result_below", "path": "back.lo_keyboard_held", "max": 0},
    {"check": "result_above", "path": "supply.sup_ready", "min": 1},
    {"check": "result_above", "path": "req.sup_inbound", "min": 1},
    {"check": "result_above", "path": "members.matching", "min": 1},
    {"check": "result_below", "path": "full.overflow", "max": 0},
    {"check": "result_below", "path": "cleanup.lo_templates", "max": 0}
  ]
}
