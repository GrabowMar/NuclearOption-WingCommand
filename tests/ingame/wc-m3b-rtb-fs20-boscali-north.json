  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "launch.launched",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "departed.flying",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "recover.recovering",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "ground.landed",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "ground.reserved",
      "min": 2
    },
    {
      "check": "result_below",
      "path": "ground.landing_failed",
      "max": 1
    }
  ]
