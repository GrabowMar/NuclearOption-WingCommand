      "op": "spawn",
      "id": "lead",
      "type": "FS-20 Vortex",
      "at": {
        "map": [
          -18632,
          32049
        ]
      },
      "altitude": 900,
      "speed": 150,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "lead",
      "program": [
        {
          "orbit": {
            "bank": 15,
            "seconds": 960
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Launch",
      "store": "launch",
      "args": {
        "lead": "lead",
        "field": "airbase_boscali_north",
        "count": 2,
        "type": "FS-20 Vortex"
      }
    },
    {
      "op": "record",
      "ids": [
        "lead"
      ],
      "hz": 2
    },
    {
      "op": "wait",
      "seconds": 240
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Ground",
      "store": "departed"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Rtb",
      "store": "recover"
    },
    {
      "op": "wait",
      "seconds": 240
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Ground",
      "store": "midway"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.DumpFields"
    },
    {
      "op": "wait",
      "seconds": 420
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Ground",
      "store": "ground"
    },
    {
      "op": "call",
      "method": "WingCommand.Automation.Metrics",
      "store": "wing"
    },
    {
      "op": "end"
    }
