<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless flight simulation: runs the production Pure/ pipeline against reduced-order plants so
       formation, rejoin, taxi and decision scenarios are real regression tests. Plants are test doubles
       calibrated from in-game telemetry; they never ship. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>WingCommand.FlightSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Assets\Data\formations.json" Link="formations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\WingCommand.PureTests\Fixtures\airbases\*.json" Link="Fixtures\airbases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="Production engine-free code under test">
    <Compile Include="..\..\Pure\**\*.cs" Link="Pure\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
